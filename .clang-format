BasedOnStyle: LLVM

IndentWidth: 4
TabWidth: 4
UseTab: Never
ContinuationIndentWidth: 4
ConstructorInitializerIndentWidth: 4
AccessModifierOffset: -4
IndentCaseLabels: true
LambdaBodyIndentation: OuterScope
NamespaceIndentation: All

ColumnLimit: 100

# --- Brackets: block indent, one item per line when too long ---
AlignAfterOpenBracket: BlockIndent
AlignOperands: DontAlign
BinPackArguments: false
BinPackParameters: OnePerLine
BinPackLongBracedList: false
AllowAllArgumentsOnNextLine: false
BreakBeforeTemplateCloser: true
Cpp11BracedListStyle: true

# --- Operators: break before them, one per line ---
BreakBeforeBinaryOperators: NonAssignment
BreakBinaryOperations: OnePerLine
BreakBeforeTernaryOperators: true

# --- Braces: K&R style, `} else {` ---
BreakBeforeBraces: Attach
InsertNewlineAtEOF: true

# --- Short constructs: rustfmt only keeps empty blocks/structs on one line ---
AllowShortFunctionsOnASingleLine: Empty
AllowShortRecordOnASingleLine: Empty
AllowShortBlocksOnASingleLine: Never
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false
AllowShortEnumsOnASingleLine: false
AllowShortNamespacesOnASingleLine: false
AllowShortLambdasOnASingleLine: Inline
AllowShortCompoundRequirementOnASingleLine: true

# --- Signatures & C++20/23 Concepts ---
BreakAfterReturnType: Automatic
PenaltyReturnTypeOnItsOwnLine: 1000
BreakAfterAttributes: Always
BreakTemplateDeclarations: No
BreakBeforeConceptDeclarations: Never
RequiresClausePosition: OwnLine
RequiresExpressionIndentation: OuterScope
IndentRequiresClause: false
AllowBreakBeforeNoexceptSpecifier: OnlyWithParen
BreakConstructorInitializers: AfterColon
BreakInheritanceList: AfterColon
PackConstructorInitializers: Never

# --- Trailing commas, blank lines, comments ---
EnumTrailingComma: Insert
MaxEmptyLinesToKeep: 1
KeepEmptyLines:
  AtStartOfBlock: false
  AtStartOfFile: false
  AtEndOfFile: false
WrapNamespaceBodyWithEmptyLines: Never
SeparateDefinitionBlocks: Always
EmptyLineAfterAccessModifier: Always
EmptyLineBeforeAccessModifier: Always
AlignTrailingComments:
  Kind: Never
SpacesBeforeTrailingComments: 1
ReflowComments: Never
BreakStringLiterals: false

# --- Alignment: rustfmt never aligns columns ---
AlignConsecutiveAssignments: None
AlignConsecutiveDeclarations: None
AlignConsecutiveMacros: None
AlignConsecutiveBitFields: None
AlignArrayOfStructures: None

# --- Syntax cleanup ---
InsertBraces: true
RemoveSemicolon: true
RemoveParentheses: ReturnStatement
SortUsingDeclarations: LexicographicNumeric

# --- Misc ---
PointerAlignment: Left
ReferenceAlignment: Left
SpaceBeforeParens: ControlStatements
FixNamespaceComments: true
IntegerLiteralSeparator:
  Binary: 0
  Decimal: 3
  DecimalMinDigits: 5
  Hex: 0
Standard: Latest

# --- Includes: std first, then project ---
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^<.*>'
    Priority: 1
  - Regex: '^".*"'
    Priority: 2
SortIncludes:
  Enabled: true
  IgnoreCase: true
