# Select a compiler cache without making it a build requirement.
include_guard(GLOBAL)

set(_raster_cache_tool "")
if(RASTER_CACHE_TOOL STREQUAL "AUTO" OR RASTER_CACHE_TOOL STREQUAL "CCACHE")
    find_program(RASTER_CCACHE_PROGRAM ccache)
    if(RASTER_CCACHE_PROGRAM)
        set(_raster_cache_tool ccache)
    endif()
endif()
if(NOT _raster_cache_tool AND
   (RASTER_CACHE_TOOL STREQUAL "AUTO" OR RASTER_CACHE_TOOL STREQUAL "SCCACHE"))
    find_program(RASTER_SCCACHE_PROGRAM sccache)
    if(RASTER_SCCACHE_PROGRAM)
        set(_raster_cache_tool sccache)
    endif()
endif()

if(_raster_cache_tool STREQUAL "ccache")
    set(CMAKE_CXX_COMPILER_LAUNCHER "${RASTER_CCACHE_PROGRAM}")
    message(STATUS "raster: using ccache (${RASTER_CCACHE_PROGRAM})")
elseif(_raster_cache_tool STREQUAL "sccache")
    set(CMAKE_CXX_COMPILER_LAUNCHER "${RASTER_SCCACHE_PROGRAM}")
    message(STATUS "raster: using sccache (${RASTER_SCCACHE_PROGRAM})")
elseif(NOT RASTER_CACHE_TOOL STREQUAL "AUTO" AND NOT RASTER_CACHE_TOOL STREQUAL "NONE")
    message(FATAL_ERROR "RASTER_CACHE_TOOL must be AUTO, CCACHE, SCCACHE or NONE")
else()
    message(STATUS "raster: compiler cache disabled")
endif()
