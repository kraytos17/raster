# Prefer mold, then lld, but gracefully fall back to the compiler default.
include_guard(GLOBAL)

if(RASTER_USE_FAST_LINKER)
    if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU" AND RASTER_ENABLE_LTO)
        message(STATUS "raster: using compiler-default linker for GCC LTO compatibility")
    else()
        find_program(RASTER_MOLD_PROGRAM mold)
        if(RASTER_MOLD_PROGRAM)
            set(CMAKE_LINKER_TYPE MOLD)
            message(STATUS "raster: using mold linker")
        else()
            find_program(RASTER_LLD_PROGRAM ld.lld)
            if(RASTER_LLD_PROGRAM)
                set(CMAKE_LINKER_TYPE LLD)
                message(STATUS "raster: using lld linker")
            else()
                message(STATUS "raster: no fast linker found; using the compiler default")
            endif()
        endif()
    endif()
endif()
